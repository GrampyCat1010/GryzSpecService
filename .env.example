# LOCAL: development + SQLite. On Render set APP_ENV=production.
APP_ENV=development
PUBLIC_URL=http://localhost:8000
WORKER_ENABLED=true

# Supabase: Project URL and server-only service_role / secret key. Run migrations/001_supabase.sql first.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_PHOTO_BUCKET=order-photos

# Company contacts (public). Phone left blank renders a placeholder.
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_EMAIL=
# Uncomment and replace BOTH coordinates of your service centre.
# COMPANY_LATITUDE=55.751244
# COMPANY_LONGITUDE=37.618423
# COMPANY_YEARS=10
TELEGRAM_URL=
MAX_URL=

# Telegram delivery: bot must be a member of the chat with permission to send/delete messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Optional comma-separated numeric user IDs permitted to press the completion button.
TELEGRAM_MANAGER_IDS=

# Render Free blocks SMTP. Use mail_transport=resend for HTTPS email delivery.
# Without a verified domain, use onboarding@resend.dev and send only to the Resend account email.
MAIL_TRANSPORT=resend
RESEND_API_KEY=
SMTP_FROM=onboarding@resend.dev
MANAGER_EMAIL=
# For hosting that permits SMTP: MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false

# AI consultant. Model can be replaced without changing code.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Browser Maps JavaScript API key: restrict it by website domain in Yandex console.
YANDEX_MAPS_API_KEY=
# Server routing key: Matrix API for road distance.
YANDEX_ROUTING_API_KEY=
# Organization numeric ID for official reviews widget.
YANDEX_ORG_ID=

MAX_PHOTOS=5
MAX_UPLOAD_MB=8
